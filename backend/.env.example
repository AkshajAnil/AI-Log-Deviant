GROQ_API_KEY=your_groq_api_key_here

# Must be a model your key can access: check https://api.groq.com/openai/v1/models
# Verified working: openai/gpt-oss-120b (recommended), openai/gpt-oss-20b, qwen/qwen3.8-27b
# NOT available on developer plans: llama-3.3-70b-versatile, llama-3.1-8b-instant (Enterprise)
# Removed from Groq: gemma2-9b-it
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL (current)
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/Log-Deviation

# MySQL (alternative)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/log_deviation
